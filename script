#Меню
def get_main_keyboard():
    markup = types.ReplyKeyboardMarkup(resize_keyboard=True)
    btn_fact = types.KeyboardButton("🌱 Эко-факт дня")
    btn_tips = types.KeyboardButton("💡 Полезные привычки")
    btn_quiz = types.KeyboardButton("❓ Эко-викторина")
    
    markup.add(btn_fact, btn_tips)
    markup.add(btn_quiz)
    return markup


#Старт
