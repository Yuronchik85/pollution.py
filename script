#Обработка обычных кнопок
@bot.message_handler(content_types=['text'])
def handle_text_buttons(message):
    
    if message.text == "🌱 Эко-факт дня":
        #Рандом факт
        random_fact = random.choice(eco_facts)
        bot.send_message(message.chat.id, f"💡 **Интересный факт:**\n\n{random_fact}", parse_mode="Markdown")
        
    elif message.text == "💡 Полезные привычки":
        tips_text = (
            "Вот 3 простых шага к экологичной жизни:\n\n"
            "1️⃣ **Носи шоппер.** Замени пластиковые пакеты тканевой сумкой.\n"
            "2️⃣ **Выключай воду.** Закрывай кран, пока чистишь зубы.\n"
            "3️⃣ **Откажись от пластика.** Используй многоразовые бутылки для воды."
        )
        bot.send_message(message.chat.id, tips_text, parse_mode="Markdown")
        
    elif message.text == "❓ Эко-викторина":
        #Случайный вопрос из словаря
        q_index = random.randint(0, len(quiz_questions) - 1)
        question = quiz_questions[q_index]
        
        #Инлай-кнопка для выбора ответа
        quiz_markup = types.InlineKeyboardMarkup()
        
        for i, answer in enumerate(question["answers"]):
            btn = types.InlineKeyboardButton(text=answer, callback_data=f"quiz_{q_index}_{i}")
            quiz_markup.add(btn)
        
        bot.send_message(
            message.chat.id, 
            f"🧠 **Вопрос:**\n\n{question['text']}",
            reply_markup=quiz_markup,
            parse_mode="Markdown"
        )
    else:
        bot.send_message(
            message.chat.id, 
            "Я не знаю такой команды. Нажми на кнопку из меню ниже 👇", 
            reply_markup=get_main_keyboard()
        )


#Проверка ответов из викториныы
@bot.callback_query_handler(func=lambda call: call.data.startswith('quiz_'))
def handle_quiz_answers(call):
    data_parts = call.data.replace("quiz_", "").split("_")
    q_index = int(data_parts[0])
    chosen_answer_index = int(data_parts[1])
    
    question = quiz_questions[q_index]
    correct_index = question["correct"]
    
    if chosen_answer_index == correct_index:
        bot.answer_callback_query(call.id, text="Правильно! 🎉", show_alert=True)
        bot.edit_message_text(
            chat_id=call.message.chat.id,
            message_id=call.message.message_id,
            text=f"✅ **Верно!**\n\n{question['text']}\n👉 Твой ответ: *{question['answers'][chosen_answer_index]}*",
            parse_mode="Markdown"
        )
    else:
        bot.answer_callback_query(call.id, text="Неверно 😔", show_alert=False)
        bot.edit_message_text(
            chat_id=call.message.chat.id,
            message_id=call.message.message_id,
            text=f"❌ **Неправильно.**\n\n{question['text']}\n👉 Правильный ответ: *{question['answers'][correct_index]}*",
            parse_mode="Markdown"
        )


